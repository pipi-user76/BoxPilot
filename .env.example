PROJECT_NAME=BoxPilot API
PROJECT_VERSION=0.1.0
SANDBOX_URL=http://127.0.0.1:8080
SANDBOX_WORK_ROOT=/home/gem/boxpilot
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_HEALTH_TIMEOUT_SECONDS=5
DATABASE_PATH=data/boxpilot.db
ARTIFACT_ROOT=artifacts
MAX_ARTIFACT_BYTES=20971520
TRUSTED_GIT_HOSTS=github.com,gitee.com,gitlab.com
REPO_TEST_TIMEOUT_SECONDS=180
REPO_CLONE_ATTEMPTS=2
REPO_CLONE_TIMEOUT_SECONDS=60
REPO_INSTALL_TIMEOUT_SECONDS=240
# 可选：依赖包源与 Python 解释器下载源；不设置时用代码里的默认镜像（阿里云 + npmmirror）。
# 需要官方源时显式设为空字符串。
# UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# UV_PYTHON_INSTALL_MIRROR=https://registry.npmmirror.com/-/binary/python-build-standalone
WEB_ACCEPTANCE_TIMEOUT_SECONDS=60
STEP_TIMEOUT_SECONDS=240
TASK_TIMEOUT_SECONDS=900
ENABLE_DEMO_TASKS=true
LOG_LEVEL=INFO
LOG_FILE=logs/boxpilot.jsonl
TASK_PAGE_SIZE_DEFAULT=20
TASK_PAGE_SIZE_MAX=100
PREVIEW_TEXT_LIMIT=200000

# 安全边界
DEDUPE_WINDOW_SECONDS=300
RATE_LIMIT_PER_MINUTE=20
URL_MAX_LENGTH=2048
COMMAND_MAX_LENGTH=8192
# 本机代理（Clash 等）把域名解析到 198.18.0.0/15 时放行；云服务器部署建议改成 false。
TRUST_PROXY_DNS=true

# 登录会话
# 生产环境必须改成随机长字符串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800
# 启用 HTTPS 后改为 true，否则 Cookie 可能随 HTTP 传输。
SESSION_COOKIE_SECURE=false

# LLM 网关（OpenAI 兼容）；不填 API Key 时 AI 能力自动降级，不影响四类任务。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 推理类模型（如 kimi-k3）不接受 temperature，不填时请求不携带该字段。
# LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000

# 定时任务：后台线程扫描间隔（秒）与单次最多触发数。
SCHEDULE_POLL_SECONDS=20
SCHEDULE_MAX_PER_TICK=5

# 知识库上传单文件上限（字节，默认 10 MB）。
KB_UPLOAD_MAX_BYTES=10485760


# 知识库向量目录（Chroma 持久化路径）
CHROMA_PATH=data/chroma
