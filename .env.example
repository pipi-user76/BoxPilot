PROJECT_NAME=BoxPilot API
PROJECT_VERSION=0.1.0
SANDBOX_URL=http://127.0.0.1:8080
SANDBOX_WORK_ROOT=/home/gem/boxpilot
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_HEALTH_TIMEOUT_SECONDS=5
ARTIFACT_ROOT=artifacts
MAX_ARTIFACT_BYTES=20971520
TRUSTED_GIT_HOSTS=github.com,gitee.com,gitlab.com
REPO_TEST_TIMEOUT_SECONDS=180
WEB_ACCEPTANCE_TIMEOUT_SECONDS=60
ENABLE_DEMO_TASKS=true
LOG_LEVEL=INFO
LOG_FILE=logs/boxpilot.jsonl
TASK_PAGE_SIZE_DEFAULT=20
TASK_PAGE_SIZE_MAX=100
PREVIEW_TEXT_LIMIT=200000
